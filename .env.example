# Roboflow
ROBOFLOW_API_KEY=your_key_here
MODEL_ID=print-failures/1
INFERENCE_URL=http://localhost:9001

# Pi / camera / Moonraker
SNAPSHOT_URL=http://PI_IP/webcam/?action=snapshot
MOONRAKER_URL=http://PI_IP:7125

# n8n webhook that pauses the print and alerts Slack
N8N_WEBHOOK_URL=https://n8n.example.com/webhook/print-guard

# Detector behavior
FAILURE_CLASSES=spaghetti,detached
CONFIDENCE=0.6
CONSECUTIVE_HITS=5
POLL_SECONDS=5
COOLDOWN_SECONDS=600
